generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Domain {
  general
  health
  legal
  education
  news
  conversational
}

enum Difficulty {
  easy
  medium
  hard
}

enum AgeGroup {
  under_18
  age_18_35   @map("18_35")
  age_36_55   @map("36_55")
  age_56_plus @map("56_plus")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  ANALYST
  RESEARCHER
  CONTRIBUTOR
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DonationProvider {
  STRIPE
  MTN_MOMO
}

enum CampaignStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  TRANSLATION_QUALITY
  ACCOUNT
  DATA_REQUEST
  FUNDING
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ConsentDecision {
  GRANTED
  WITHDRAWN
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum SourceKind {
  LEGACY_UNKNOWN
  MANUAL
  SEEDED
  DATASET_IMPORT
}

enum CopyrightStatus {
  UNKNOWN
  LICENSED
  PUBLIC_DOMAIN
  PERMISSION_GRANTED
  RESTRICTED
}

enum ResearchReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum TranslationReviewState {
  PENDING_REVIEW
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  ADJUDICATION_REQUIRED
  RETRACTED
}

enum ReviewAssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum ReviewDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
  ABSTAIN
}

enum AdjudicationDecision {
  APPROVE
  REJECT
  RETURN_FOR_REVISION
}

enum ProficiencyLevel {
  NONE
  LIMITED
  WORKING
  PROFICIENT
  DOMINANT
}

enum UsageFrequency {
  RARELY
  MONTHLY
  WEEKLY
  DAILY
}

enum AnnotationRegister {
  GENERAL
  CASUAL
  FORMAL
  TECHNICAL
  CEREMONIAL
  OTHER
}

enum TranslationUncertainty {
  CONFIDENT
  SOME_UNCERTAINTY
  NEEDS_DISCUSSION
}

enum AnnotationOutcome {
  TRANSLATED
  UNTRANSLATABLE
  CULTURALLY_SENSITIVE
  NEEDS_CONTEXT
}

enum DatasetReleaseStatus {
  DRAFT
  PUBLISHED
  RESTRICTED
  RETRACTED
  DEPRECATED
}

enum DatasetSplit {
  TRAIN
  VALIDATION
  TEST
}

model Language {
  id         String   @id @default(uuid())
  value      String   @unique
  label      String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  autonym          String?
  iso639_3         String?
  glottocode       String?
  default_script   String?
  metadata_version String?

  varieties LanguageVariety[]

  @@map("languages")
}

model EnglishSample {
  id                String     @id @default(uuid())
  text              String
  audio_path        String?
  domain            Domain
  difficulty        Difficulty
  translation_count Int        @default(0)
  is_locked         Boolean    @default(false)
  is_gold_standard  Boolean    @default(false)
  legacy_iaa_score  Float?     @map("iaa_score") // retained only for migration compatibility
  created_at        DateTime   @default(now())

  // Source and rights provenance. Legacy rows remain ineligible until reviewed.
  text_hash                 String?              @unique
  near_duplicate_group      String?
  source_kind               SourceKind           @default(LEGACY_UNKNOWN)
  source_dataset            String?
  source_dataset_version    String?
  source_record_id          String?
  source_url                String?
  source_citation           String?
  source_license            String?
  source_license_url        String?
  copyright_status          CopyrightStatus      @default(UNKNOWN)
  source_usage_restrictions String?
  source_release_eligible   Boolean              @default(false)
  original_text             String?
  importer_version          String?
  imported_by               String?
  imported_at               DateTime?
  provenance_metadata       Json?
  specialist_review_status  ResearchReviewStatus @default(PENDING)
  specialist_reviewed_by    String?
  specialist_reviewed_at    DateTime?
  specialist_review_notes   String?

  translations             Translation[]
  gold_standards           GoldStandard[]
  surfaceSimilaritySignals SurfaceSimilaritySignal[]

  @@index([domain])
  @@index([is_locked])
  @@index([is_gold_standard])
  @@index([near_duplicate_group])
  @@index([source_release_eligible])
  @@index([specialist_review_status])
  @@map("english_samples")
}

model Translation {
  id                           String                 @id @default(uuid())
  sample_id                    String
  contributor_id               String
  target_language              String
  dialect                      String?
  translated_text              String
  audio_path                   String?
  english_audio_path           String?
  is_validated                 Boolean                @default(false)
  quality_score                Float?
  gold_sim_score               Float?
  created_at                   DateTime               @default(now())
  updated_at                   DateTime               @default(now()) @updatedAt
  review_state                 TranslationReviewState @default(PENDING_REVIEW)
  current_revision             Int                    @default(1)
  language_variety_id          String?
  orthography_id               String?
  guideline_id                 String?
  register                     AnnotationRegister     @default(GENERAL)
  contains_code_switching      Boolean                @default(false)
  code_switching_notes         String?
  uncertainty                  TranslationUncertainty @default(CONFIDENT)
  annotation_outcome           AnnotationOutcome      @default(TRANSLATED)
  alternative_translation      String?
  annotation_notes             String?
  linguistic_metadata_complete Boolean                @default(false)

  sample            EnglishSample             @relation(fields: [sample_id], references: [id])
  contributor       Contributor               @relation(fields: [contributor_id], references: [id])
  revisions         TranslationRevision[]
  reviewAssignments ReviewAssignment[]
  reviews           TranslationReview[]
  adjudications     TranslationAdjudication[]
  languageVariety   LanguageVariety?          @relation(fields: [language_variety_id], references: [id], onDelete: Restrict)
  orthography       Orthography?              @relation(fields: [orthography_id], references: [id], onDelete: Restrict)
  guideline         AnnotationGuideline?      @relation(fields: [guideline_id], references: [id], onDelete: Restrict)
  releaseItems      DatasetReleaseItem[]

  @@unique([sample_id, contributor_id, target_language])
  @@index([sample_id, target_language])
  @@index([contributor_id])
  @@map("translations")
}

model Contributor {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password_hash    String? // null for SSO-only accounts
  native_language  String? // null until profile is complete
  native_dialect   String?
  region_of_origin String? // null until profile is complete
  age_group        AgeGroup? // null until profile is complete
  is_l1_speaker    Boolean? // null until profile is complete
  reputation_score Float     @default(1.0)
  is_admin         Boolean   @default(false)
  role             Role      @default(CONTRIBUTOR)
  is_active        Boolean   @default(true)

  // Email verification
  email_verified       Boolean   @default(false)
  verification_token   String?   @unique
  verification_sent_at DateTime?

  // OAuth / SSO
  google_id      String? @unique
  github_id      String? @unique
  oauth_provider String? // 'google' | 'github' | null (password)

  // Profile completeness flag (SSO users must fill profile before translating)
  is_profile_complete Boolean @default(false)

  // Two-factor authentication (TOTP)
  totp_secret  String? // base32 secret, null when 2FA not set up
  totp_enabled Boolean @default(false)

  // Pending email change (new address stored here until link is clicked)
  pending_email String?

  // Password reset
  reset_token            String?   @unique
  reset_token_expires_at DateTime?

  // Public profile
  photo_url  String?
  profession String?

  // Researcher profile (shown on landing page)
  affiliation            String?
  orcid_id               String?
  linkedin_url           String?
  researcher_bio         String?
  is_featured_researcher Boolean @default(false)

  created_at DateTime @default(now())

  translations                  Translation[]
  apiKeys                       ApiKey[]
  auditLogs                     AuditLog[]                      @relation("ActorAuditLogs")
  supportTickets                SupportTicket[]
  badges                        ContributorBadge[]
  campaignsCreated              Campaign[]
  consentRecords                ConsentRecord[]
  governanceApprovals           GovernanceApproval[]
  governanceAuthorities         GovernanceAuthorityAssignment[] @relation("GovernanceAuthorityHolder")
  governanceAuthoritiesAssigned GovernanceAuthorityAssignment[] @relation("GovernanceAuthorityAssigner")
  reviewAssignments             ReviewAssignment[]              @relation("AssignedReviewer")
  reviewAssignmentsCreated      ReviewAssignment[]              @relation("ReviewAssigner")
  translationReviews            TranslationReview[]
  translationAdjudications      TranslationAdjudication[]
  languageProfiles              ContributorLanguageProfile[]
  consentStates                 ConsentState[]
  releasePseudonyms             ReleasePseudonym[]

  @@map("contributors")
}

model ContributorBadge {
  id             String   @id @default(uuid())
  contributor_id String
  slug           String // e.g. 'first_translation', 'streak_7', 'translations_50'
  awarded_at     DateTime @default(now())

  contributor Contributor @relation(fields: [contributor_id], references: [id], onDelete: Cascade)

  @@unique([contributor_id, slug])
  @@index([contributor_id])
  @@map("contributor_badges")
}

model Campaign {
  id          String         @id @default(uuid())
  title       String
  description String?
  language    String
  domain      Domain?
  goal        Int
  progress    Int            @default(0) // cached count, updated on translation submit
  status      CampaignStatus @default(UPCOMING)
  start_date  DateTime
  end_date    DateTime
  badge_slug  String? // badge awarded to contributors who reach personal goal
  created_by  String
  is_active   Boolean        @default(true)
  created_at  DateTime       @default(now())

  creator Contributor @relation(fields: [created_by], references: [id])

  @@index([language])
  @@index([status])
  @@index([is_active])
  @@map("campaigns")
}

model Donation {
  id             String           @id @default(uuid())
  donor_name     String?
  donor_email    String?
  amount         Float
  currency       String           @default("USD")
  provider       DonationProvider
  status         DonationStatus   @default(PENDING)
  provider_ref   String?          @unique // Stripe session/intent ID or MTN reference ID
  transaction_id String?          @unique // set on completion
  message        String?
  is_anonymous   Boolean          @default(false)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@index([status])
  @@index([provider])
  @@index([created_at])
  @@map("donations")
}

model SupportTicket {
  id             String         @id @default(uuid())
  name           String
  email          String
  subject        String
  category       TicketCategory @default(GENERAL)
  message        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  contributor_id String?
  response       String?
  resolved_at    DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  contributor Contributor? @relation(fields: [contributor_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([email])
  @@map("support_tickets")
}

model ApiKey {
  id             String    @id @default(uuid())
  key_hash       String    @unique
  prefix         String
  name           String
  contributor_id String
  last_used_at   DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())

  contributor Contributor @relation(fields: [contributor_id], references: [id])

  @@index([contributor_id])
  @@map("api_keys")
}

model DatasetPublication {
  id              String   @id @default(uuid())
  language        String   @unique
  is_active       Boolean  @default(true)
  record_count    Int      @default(0) // validated translation count
  audio_count     Int      @default(0) // translations with spoken recordings
  text_only_count Int      @default(0) // translations without audio
  avg_quality     Float? // mean quality_score of validated set
  domain_dist     Json? // { health: N, legal: N, … }
  version         Int      @default(1) // bumped each time the dataset is re-published
  published_at    DateTime @default(now())
  published_by    String

  @@map("dataset_publications")
}

model GoldStandard {
  id                    String   @id @default(uuid())
  sample_id             String
  target_language       String
  reference_translation String
  created_by            String
  created_at            DateTime @default(now())

  sample EnglishSample @relation(fields: [sample_id], references: [id])

  @@index([sample_id, target_language])
  @@map("gold_standard")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String // user_created, user_updated, user_deleted, user_deactivated, user_activated, role_changed, etc.
  actor_id      String // admin who performed action
  target_id     String? // user affected (null for system actions)
  resource_type String // User, Translation, etc.
  changes       Json? // { field: { old, new } }
  ip_address    String?
  created_at    DateTime @default(now())

  actor Contributor @relation("ActorAuditLogs", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([actor_id])
  @@index([target_id])
  @@index([created_at])
  @@map("audit_logs")
}

/// A versioned policy or participant-information document. Content is stored
/// outside the database; the hash makes the exact accepted text auditable.
model ResearchPolicy {
  id                 String       @id @default(uuid())
  policy_key         String
  version            String
  title              String
  content_hash       String
  content_url        String?
  status             PolicyStatus @default(DRAFT)
  requires_reconsent Boolean      @default(true)
  effective_at       DateTime?
  retired_at         DateTime?
  created_by         String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  consentRecords ConsentRecord[]
  consentStates  ConsentState[]

  @@unique([policy_key, version])
  @@index([policy_key, status])
  @@map("research_policies")
}

/// Append-only consent event. A withdrawal is a new event rather than a
/// destructive edit, preserving exactly what was agreed to and when.
model ConsentRecord {
  id             String          @id @default(uuid())
  contributor_id String
  policy_id      String
  decision       ConsentDecision
  scopes         Json
  supersedes_id  String?
  recorded_at    DateTime        @default(now())
  reason         String?
  ip_address     String?
  user_agent     String?

  contributor Contributor     @relation(fields: [contributor_id], references: [id], onDelete: Restrict)
  policy      ResearchPolicy  @relation(fields: [policy_id], references: [id], onDelete: Restrict)
  supersedes  ConsentRecord?  @relation("ConsentHistory", fields: [supersedes_id], references: [id], onDelete: Restrict)
  revisions   ConsentRecord[] @relation("ConsentHistory")

  @@index([contributor_id, policy_id, recorded_at])
  @@index([supersedes_id])
  @@map("consent_records")
}

/// Materialized effective consent for enforcement in collection and export.
/// ConsentRecord remains the immutable audit log and is the source of truth.
model ConsentState {
  id                String   @id @default(uuid())
  contributor_id    String
  policy_id         String
  text_contribution Boolean  @default(false)
  target_audio      Boolean  @default(false)
  english_audio     Boolean  @default(false)
  model_training    Boolean  @default(false)
  public_release    Boolean  @default(false)
  commercial_use    Boolean  @default(false)
  future_research   Boolean  @default(false)
  updated_at        DateTime @updatedAt

  contributor Contributor    @relation(fields: [contributor_id], references: [id], onDelete: Cascade)
  policy      ResearchPolicy @relation(fields: [policy_id], references: [id], onDelete: Restrict)

  @@unique([contributor_id, policy_id])
  @@index([policy_id, public_release, model_training])
  @@map("consent_states")
}

/// Records the human authority and decision behind policies, campaigns, gold
/// references, and releases. The target remains generic until those resources
/// receive dedicated immutable models in later phases.
model GovernanceApproval {
  id             String           @id @default(uuid())
  resource_type  String
  resource_id    String
  language       String?
  approver_id    String
  authority_role String
  decision       ApprovalDecision
  notes          String?
  decided_at     DateTime         @default(now())

  approver Contributor @relation(fields: [approver_id], references: [id], onDelete: Restrict)

  @@index([resource_type, resource_id])
  @@index([language])
  @@index([approver_id])
  @@map("governance_approvals")
}

/// Assigns the two independent governance signing authorities. Assignments are
/// retained after revocation so the authority in force for a decision is auditable.
model GovernanceAuthorityAssignment {
  id                    String    @id @default(uuid())
  contributor_id        String
  authority_role        String
  active_role           String?   @unique
  active_contributor_id String?   @unique
  assigned_by           String
  assigned_at           DateTime  @default(now())
  revoked_at            DateTime?

  contributor Contributor @relation("GovernanceAuthorityHolder", fields: [contributor_id], references: [id], onDelete: Restrict)
  assigner    Contributor @relation("GovernanceAuthorityAssigner", fields: [assigned_by], references: [id], onDelete: Restrict)

  @@index([authority_role, revoked_at])
  @@index([contributor_id, revoked_at])
  @@map("governance_authority_assignments")
}

model TranslationRevision {
  id                      String                 @id @default(uuid())
  translation_id          String
  revision_no             Int
  translated_text         String
  dialect                 String?
  audio_path              String?
  english_audio_path      String?
  guideline_version       String?
  collection_code         String?
  change_reason           String?
  created_by              String
  created_at              DateTime               @default(now())
  language_variety_id     String?
  orthography_id          String?
  guideline_id            String?
  register                AnnotationRegister     @default(GENERAL)
  contains_code_switching Boolean                @default(false)
  code_switching_notes    String?
  uncertainty             TranslationUncertainty @default(CONFIDENT)
  annotation_outcome      AnnotationOutcome      @default(TRANSLATED)
  alternative_translation String?
  annotation_notes        String?

  translation Translation @relation(fields: [translation_id], references: [id], onDelete: Cascade)

  @@unique([translation_id, revision_no])
  @@index([created_by])
  @@map("translation_revisions")
}

model ReviewAssignment {
  id             String                 @id @default(uuid())
  translation_id String
  reviewer_id    String
  revision_no    Int
  assigned_by    String
  status         ReviewAssignmentStatus @default(ASSIGNED)
  is_blind       Boolean                @default(true)
  assigned_at    DateTime               @default(now())
  completed_at   DateTime?

  translation Translation @relation(fields: [translation_id], references: [id], onDelete: Cascade)
  reviewer    Contributor @relation("AssignedReviewer", fields: [reviewer_id], references: [id], onDelete: Restrict)
  assigner    Contributor @relation("ReviewAssigner", fields: [assigned_by], references: [id], onDelete: Restrict)

  @@unique([translation_id, revision_no, reviewer_id])
  @@index([reviewer_id, status])
  @@map("review_assignments")
}

model TranslationReview {
  id                       String         @id @default(uuid())
  translation_id           String
  revision_no              Int
  reviewer_id              String
  decision                 ReviewDecision
  adequacy                 Int?
  fluency                  Int?
  orthography              Int?
  dialect_fit              Int?
  cultural_appropriateness Int?
  audio_intelligibility    Int?
  error_labels             Json?
  comments                 String?
  created_at               DateTime       @default(now())

  translation Translation @relation(fields: [translation_id], references: [id], onDelete: Cascade)
  reviewer    Contributor @relation(fields: [reviewer_id], references: [id], onDelete: Restrict)

  @@unique([translation_id, revision_no, reviewer_id])
  @@index([reviewer_id])
  @@map("translation_reviews")
}

model TranslationAdjudication {
  id             String               @id @default(uuid())
  translation_id String
  revision_no    Int
  adjudicator_id String
  decision       AdjudicationDecision
  final_score    Float?
  notes          String
  created_at     DateTime             @default(now())

  translation Translation @relation(fields: [translation_id], references: [id], onDelete: Cascade)
  adjudicator Contributor @relation(fields: [adjudicator_id], references: [id], onDelete: Restrict)

  @@unique([translation_id, revision_no])
  @@index([adjudicator_id])
  @@map("translation_adjudications")
}

model SurfaceSimilaritySignal {
  id              String   @id @default(uuid())
  sample_id       String
  target_language String
  score           Float
  method          String   @default("character_3gram_jaccard")
  computed_at     DateTime @default(now())

  sample EnglishSample @relation(fields: [sample_id], references: [id], onDelete: Cascade)

  @@unique([sample_id, target_language, method])
  @@index([target_language])
  @@map("surface_similarity_signals")
}

model LanguageVariety {
  id            String       @id @default(uuid())
  language_id   String
  code          String       @unique
  name          String
  autonym       String?
  dialect_group String?
  iso639_3      String?
  glottocode    String?
  bcp47         String?
  region        String?
  description   String?
  status        PolicyStatus @default(DRAFT)
  approved_by   String?
  approved_at   DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  language            Language                     @relation(fields: [language_id], references: [id], onDelete: Restrict)
  orthographies       Orthography[]
  contributorProfiles ContributorLanguageProfile[]
  guidelines          AnnotationGuideline[]
  translations        Translation[]

  @@index([language_id, status])
  @@map("language_varieties")
}

model Orthography {
  id          String       @id @default(uuid())
  variety_id  String
  code        String       @unique
  name        String
  script      String
  version     String?
  authority   String?
  description String?
  is_default  Boolean      @default(false)
  status      PolicyStatus @default(DRAFT)
  approved_by String?
  approved_at DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  variety      LanguageVariety       @relation(fields: [variety_id], references: [id], onDelete: Restrict)
  guidelines   AnnotationGuideline[]
  translations Translation[]

  @@index([variety_id, status])
  @@map("orthographies")
}

model ContributorLanguageProfile {
  id                   String           @id @default(uuid())
  contributor_id       String
  variety_id           String
  speaking_proficiency ProficiencyLevel
  reading_proficiency  ProficiencyLevel
  writing_proficiency  ProficiencyLevel
  usage_frequency      UsageFrequency
  age_of_acquisition   Int?
  place_learned        String?
  current_use_region   String?
  literacy_training    String?
  is_first_language    Boolean          @default(false)
  self_reported        Boolean          @default(true)
  verified_by          String?
  verified_at          DateTime?
  notes                String?
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  contributor Contributor     @relation(fields: [contributor_id], references: [id], onDelete: Cascade)
  variety     LanguageVariety @relation(fields: [variety_id], references: [id], onDelete: Restrict)

  @@unique([contributor_id, variety_id])
  @@index([variety_id])
  @@map("contributor_language_profiles")
}

model AnnotationGuideline {
  id             String       @id @default(uuid())
  variety_id     String
  orthography_id String?
  version        String
  title          String
  content_hash   String
  content_url    String
  status         PolicyStatus @default(DRAFT)
  effective_at   DateTime?
  retired_at     DateTime?
  approved_by    String?
  approved_at    DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  variety      LanguageVariety @relation(fields: [variety_id], references: [id], onDelete: Restrict)
  orthography  Orthography?    @relation(fields: [orthography_id], references: [id], onDelete: Restrict)
  translations Translation[]

  @@unique([variety_id, orthography_id, version])
  @@index([variety_id, status])
  @@map("annotation_guidelines")
}

model DatasetRelease {
  id                 String               @id @default(uuid())
  language           String
  semantic_version   String
  status             DatasetReleaseStatus @default(DRAFT)
  schema_version     String
  git_commit         String
  split_algorithm    String
  split_seed         String
  split_mode         String
  manifest_checksum  String?
  artifact_checksum  String?
  artifact_url       String?
  license_key        String
  inclusion_criteria Json
  record_count       Int                  @default(0)
  changelog          String?
  created_by         String
  created_at         DateTime             @default(now())
  published_by       String?
  published_at       DateTime?
  restricted_at      DateTime?
  retracted_at       DateTime?
  retraction_reason  String?

  items       DatasetReleaseItem[]
  pseudonyms  ReleasePseudonym[]
  corrections DatasetCorrection[]

  @@unique([language, semantic_version])
  @@index([language, status])
  @@map("dataset_releases")
}

model DatasetReleaseItem {
  id                      String       @id @default(uuid())
  release_id              String
  translation_id          String
  translation_revision_no Int
  source_group            String
  duplicate_group         String?
  speaker_pseudonym       String
  split                   DatasetSplit
  record_checksum         String
  record_snapshot         Json
  created_at              DateTime     @default(now())

  release     DatasetRelease @relation(fields: [release_id], references: [id], onDelete: Restrict)
  translation Translation    @relation(fields: [translation_id], references: [id], onDelete: Restrict)

  @@unique([release_id, translation_id])
  @@index([release_id, split])
  @@index([source_group, split])
  @@index([speaker_pseudonym, split])
  @@map("dataset_release_items")
}

model ReleasePseudonym {
  id             String   @id @default(uuid())
  release_id     String
  contributor_id String
  pseudonym      String
  created_at     DateTime @default(now())

  release     DatasetRelease @relation(fields: [release_id], references: [id], onDelete: Restrict)
  contributor Contributor    @relation(fields: [contributor_id], references: [id], onDelete: Restrict)

  @@unique([release_id, contributor_id])
  @@unique([release_id, pseudonym])
  @@map("release_pseudonyms")
}

model DatasetCorrection {
  id              String   @id @default(uuid())
  release_id      String
  correction_type String
  description     String
  affected_ids    Json?
  created_by      String
  created_at      DateTime @default(now())

  release DatasetRelease @relation(fields: [release_id], references: [id], onDelete: Restrict)

  @@index([release_id, created_at])
  @@map("dataset_corrections")
}

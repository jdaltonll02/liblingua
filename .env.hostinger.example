# Hostinger Web App runtime (copy values into hPanel; do not commit real secrets)
NODE_ENV=production
DATABASE_URL=mysql://u549727073_dbadmin:URL_ENCODED_PASSWORD@127.0.0.1:3306/u549727073_liblingua
DB_POOL_SIZE=5
# Caps Prisma engine threads (the app defaults to 2 if unset; see HOSTINGER_DEPLOYMENT.md)
TOKIO_WORKER_THREADS=2

# Public application origin (no trailing slash)
FRONTEND_URL=https://liblingua.gibtechs.com
OAUTH_CALLBACK_BASE=https://liblingua.gibtechs.com

# Generate with a cryptographically secure password generator
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d

# Hostinger Email (create this mailbox first)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_HOSTINGER_EMAIL_ADDRESS
SMTP_PASS=REPLACE_WITH_MAILBOX_PASSWORD
SMTP_FROM=LibLingua <REPLACE_WITH_HOSTINGER_EMAIL_ADDRESS>

# S3-compatible storage is required for durable production uploads (Cloudflare R2 shown)
S3_BUCKET=liblingua
S3_REGION=auto
# Account endpoint only, without the bucket name
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
S3_FORCE_PATH_STYLE=true
# Public base URL for stored file links (R2 custom domain or r2.dev URL, no trailing slash)
S3_PUBLIC_URL=https://REPLACE_WITH_PUBLIC_BUCKET_URL

# Optional integrations
SENTRY_DSN=
VITE_SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
HF_API_KEY=
